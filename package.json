{
  "name": "dermify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "chatbot:start": "docker-compose up -d ollama",
    "chatbot:init": "docker-compose up ollama-init",
    "chatbot:stop": "docker-compose down",
    "chatbot:status": "docker-compose ps",
    "chatbot:logs": "docker-compose logs ollama",
    "redis:start": "docker-compose up -d redis",
    "redis:stop": "docker-compose stop redis",
    "redis:logs": "docker-compose logs redis",
    "services:start": "docker-compose up -d ollama redis",
    "services:stop": "docker-compose down",
    "services:status": "docker-compose ps",
    "dev:full": "npm run services:start && timeout /t 15 && npm run dev"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@upstash/redis": "^1.20.6",
    "axios": "^1.4.0",
    "bcryptjs": "^3.0.2",
    "child_process": "^1.0.2",
    "form-data": "^4.0.0",
    "fs": "^0.0.1-security",
    "ioredis": "^5.3.2",
    "multer": "^1.4.5-lts.2",
    "next": "^15.3.2",
    "next-connect": "^1.0.0",
    "next-pwa": "^5.6.0",
    "path": "^0.12.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "eslint": "^8.29.1",
    "eslint-config-next": "^15.2.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.3"
  }
}
